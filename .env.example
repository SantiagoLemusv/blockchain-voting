# Hardhat
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY
PRIVATE_KEY=0xYOUR_WALLET_PRIVATE_KEY
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_API_KEY
# Uncomment to enable gas reporter
# REPORT_GAS=true

# Frontend (filled after deploying contratos)
VITE_CONTRACT_REGISTRY_ADDRESS=0xRegistryAddress
VITE_CONTRACT_FACTORY_ADDRESS=0xFactoryAddress
VITE_NETWORK=localhost

# Opcional para scripts auxiliares (mismos valores que arriba)
REGISTRY_ADDRESS=0xRegistryAddress
FACTORY_ADDRESS=0xFactoryAddress
